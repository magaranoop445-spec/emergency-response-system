{
  "version": 2,
  "installCommand": "npm install",
  "functions": {
    "server.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/requester-dashboard.html", "destination": "/requester-dashboard.html" },
    { "source": "/provider-dashboard.html", "destination": "/provider-dashboard.html" },
    { "source": "/admin-dashboard.html", "destination": "/admin-dashboard.html" },
    { "source": "/index.html", "destination": "/index.html" },
    { "source": "/landing.css", "destination": "/landing.css" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}